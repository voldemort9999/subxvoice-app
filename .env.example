# Copy to .env. No vendor keys here any more: speech-to-text and rewriting go through Supabase Edge Functions
# that the signed-in account unlocks, and the keys live there as function secrets.
#
# What is left is developer tuning, read only in development.

# Optional recognition locale, defaults to hi-IN. One locale only.
# Others: bn-IN en-IN gu-IN kn-IN ml-IN mr-IN pa-IN ta-IN te-IN
GNANI_LANGUAGE=hi-IN
# Optional model override, defaults to prisma-v3.0.
GNANI_MODEL=
# Optional output style: verbatim | transcribe | codemix | transliterate.
GNANI_FORMAT=
# Optional rewriting model, defaults to google/gemini-3.5-flash-lite (gpt-oss-120b is the fallback).
OPENROUTER_MODEL=
