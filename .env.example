# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Temporary: AGENTS.md rule 3 says no API keys in the app. Once the backend hands out
# short-lived tokens, these move there and only the token source changes.

# Speech-to-text — https://docs.gnani.ai (keys from the Gnani dashboard)
GNANI_API_KEY=
# Optional, defaults to prisma-v3.0. v3.0 writes Indian-accented English in Latin script;
# prisma-v2.5 writes it in Devanagari but finalises ~350 ms sooner.
GNANI_MODEL=
# Optional recognition locale, defaults to hi-IN. One locale only — Gnani takes no list, and
# "indic-auto" guesses from the audio (it picked Telugu on a Hindi-English clip).
# hi-IN handles Hindi and English together, which is the code-mixed case we have.
# Others: bn-IN en-IN gu-IN kn-IN ml-IN mr-IN pa-IN ta-IN te-IN
GNANI_LANGUAGE=hi-IN
# Optional output style, defaults to verbatim: verbatim | transcribe | codemix | transliterate.
# "transliterate" returns Roman script directly but paraphrases, so the LLM still does Hinglish.
GNANI_FORMAT=

# Rewriting and Roman-script (Hinglish) output — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, defaults to openai/gpt-oss-120b (benchmarked fastest + most accurate)
OPENROUTER_MODEL=
